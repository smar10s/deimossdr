# Build artifacts
# build/ is a private-dev-repo artifact tree (AGENTS.md) — not shipped in
# the public tree. It holds the build evidence (fingerprint,
# bitstream.sha256, build_info.json, utilization.rpt, timing_status) that
# the session/build scripts read locally.
build/
firmware/build/

# Vivado project artifacts (regenerated by build)
fpga/project/*.xpr
fpga/project/*.gen/
fpga/project/*.runs/
fpga/project/*.srcs/
fpga/project/*.cache/
fpga/project/*.hw/
fpga/project/*.ip_user_files/
fpga/project/*.sim/
vivado*.jou
vivado*.log
*.wdb
*.wcfg

# Local config
config.mk

# Python
**/__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/

# direnv (.envrc is tracked — it wires up .venv and SIM=verilator)

# Simulation artifacts
fpga/test/sim_build*/
fpga/test/coverage/
fpga/test/coverage*.dat
fpga/test/results.xml
fpga/test/*.vcd
fpga/test/*.fst
fpga/test/waves/

# Git worktrees
.worktrees/

# Capture data
captures/*.json
captures/*.npy
captures/*.cf32
captures/debug/

# Transient burst tool stderr captures (hil_test.sh diagnostics)
logs/burst/

# IDE / tooling
.opencode/

# OS
.DS_Store

# Real OTA captures must never be committed again (release policy).
# Generated test input lives in stimulus/ (tracked). Real recordings
# (cable loopback is OK) must stay untracked or be excluded by the
# patterns above.
captures/*eapol*.json

# Project management
STATUS.md
AGENTS.md

# Hardware logs
logs/
